# ==========================================
# PHYTERA BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# Database (Prisma / PostgreSQL / Supabase / Neon compatible)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://phytera_user:phytera_password@localhost:5432/phytera_db?schema=public"

# Redis (Caching, Socket.io Adapter & Task Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication JWT
JWT_SECRET=phytera_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=phytera_super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRATION=7d

# Swagger Documentation Path
SWAGGER_PATH=api/docs

# Optional: Firebase Admin SDK (Mirror & Push Notifications)
FIREBASE_PROJECT_ID=phytera-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@phytera.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
